# Copy to .env (or .env.local) and fill in real values. Never commit the filled-in file.

# PostgreSQL connection
PSQL_HOST=                    # e.g. postgres (Docker Compose service name) or 127.0.0.1 locally
PSQL_DB_NAME=                 # e.g. horsemktdb
PSQL_USERNAME=                # e.g. horsemktuser
PSQL_PORT=                    # e.g. 5432
PSQL_PASSWORD=                # Postgres user password
PSQL_SSLMODE=                 # e.g. disable
PSQL_CONNECT_ARGS=            # present for historical reasons; not read by any Go code today

# PASETO authentication
PASETO_KEY=                   # symmetric key used to sign/verify PASETO tokens

# Runtime environment
ENVIRONMENT=                  # development | staging | production — "production" enables Secure cookies, requires HTTPS

# Email sending — set either the SMTP block or the Mailgun block, not both
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=                     # used by both SMTP and Mailgun senders
MAILGUN_DOMAIN=
MAILGUN_API_KEY=

# Object storage (S3-compatible; production uses DigitalOcean Spaces, local dev uses MinIO)
STORAGE_ENDPOINT=              # e.g. https://syd1.digitaloceanspaces.com in prod, http://127.0.0.1:9000 locally. Secure/HTTPS is inferred from this value's own scheme.
STORAGE_PUBLIC_ENDPOINT=       # browser-facing endpoint the app appends /{bucket}/{key} to when building media URLs — same host as STORAGE_ENDPOINT, no bucket subdomain
STORAGE_REGION=                # e.g. syd1 in prod (must match the Space's real region for AWS SigV4), us-east-1 locally (MinIO ignores this)
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=

# Mapbox geocoding
MAPBOX_API_KEY=

# Frontend origin, used for CORS and notification links
FRONTEND_URL=

# Redis (Asynq task queue)
REDIS_ADDR=                    # e.g. redis:6379

# Error tracking (Sentry) — leave empty to disable, e.g. in local dev
SENTRY_DSN=
